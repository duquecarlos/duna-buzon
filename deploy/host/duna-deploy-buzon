#!/usr/bin/env bash
# duna-deploy-buzon -- BUZON-CONECTOR-1, under Main's own
# contracts/host-deploy-v1.md (ORCH-HOST-DEPLOY-V1). Installed once, by
# hand, by Carlos (deploy/host/README.md), and granted passwordless sudo
# for exactly this one path (deploy/host/duna-deploy-buzon.sudoers). Called
# as:
#
#   sudo -n /usr/local/sbin/duna-deploy-buzon status
#   sudo -n /usr/local/sbin/duna-deploy-buzon deploy [--dry-run]
#   sudo -n /usr/local/sbin/duna-deploy-buzon entrar
#   sudo -n /usr/local/sbin/duna-deploy-buzon rollback-script
#   sudo -n /usr/local/sbin/duna-deploy-buzon carpetas <id>
#   sudo -n /usr/local/sbin/duna-deploy-buzon fijar-carpetas <id> <carpeta>...
#   sudo -n /usr/local/sbin/duna-deploy-buzon fijar-carpetas <id> --todas
#
# `carpetas`/`fijar-carpetas` are BUZON-CARPETAS-MICROSOFT-CLI-1: operator
# tooling over `fuentes/<id>/fuente.json`'s own `carpetas` setting, which
# before this slice needed a hand edit as `duna` for a microsoft source.
# `carpetas <id>` reads the source's own `proveedor` from its `fuente.json`
# (never a secret, root can read it directly) and runs `python -m
# duna_buzon carpetas <id>` for an imap source or `carpetas-graph <id>` for
# a microsoft one -- both read-only, as `duna`. `fijar-carpetas <id>
# <carpeta>...` or `fijar-carpetas <id> --todas` forwards to `python -m
# duna_buzon fijar-carpetas`, translating each positional folder name into
# its own `--carpeta` argument -- every folder name reaches python as its
# own argv element, never built into a shell string.
#
# `entrar` is the one subcommand meant for Carlos himself, run directly in
# his own SSH terminal (not over a batch/no-tty session) -- it signs in
# interactively, printing Microsoft's device-code URL to whatever terminal
# called it, and so is the one subcommand that never uses systemd-run.
#
# `deploy` self-updates (HOST-AUTOACTUALIZAR-BUZON-1): right after the pull
# and before anything that depends on the new code, it compares the pulled
# copy of this script and its sudoers fragment against what is actually
# installed, prints a diff of whatever changed, refuses a sudoers fragment
# that is not EXACTLY one NOPASSWD rule on this one path, keeps the previous
# installed copies (`.prev`) so `rollback-script` can restore them, installs
# the new copies, and re-execs itself under the newly installed script --
# once, never looping -- so the rest of that same deploy runs under the new
# code. The FIRST install of a new version of this script is still manual
# (deploy/host/README.md's "Update" section) -- autoactualizar only takes
# over from the second `deploy` onward.
#
# Every path below is a CONSTANT, never taken from argv or the environment:
# the only things argv may select are the four subcommands, --dry-run, and
# --internal-reexec (set only by autoactualizar's own re-exec, never meant
# to be typed by a caller).
set -Eeuo pipefail

# Fixed PATH, independent of the caller's shell -- this script trusts no
# inherited environment variable for its own decisions.
PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

REPO="/srv/duna/repos/duna-buzon"
DATOS_DIR="/srv/duna/data/buzon"
ENV_CLIENTE="/srv/duna/env/buzon.env"
ENV_TOKEN="/srv/duna/env/buzon-conector.env"
SERVICIO="duna-buzon.service"
TIMER="duna-buzon.timer"
UNIDADES_DIR="/etc/systemd/system"

# BUZON-CARPETAS-MICROSOFT-CLI-1 -- the only two argument shapes `carpetas`
# and `fijar-carpetas` ever accept; every id and folder name is checked
# against these before anything runs, and is always passed on to python as
# its own argv element, never interpolated into a shell string.
ID_FUENTE_RE='^[a-z0-9-]+$'
CARPETA_RE='^[A-Za-z0-9_ .-]+$'

# autoactualizar's own fixed paths (HOST-AUTOACTUALIZAR-BUZON-1) -- constants,
# like every other path above, never taken from argv or the environment.
ENTRY_INSTALADO="/usr/local/sbin/duna-deploy-buzon"
SUDOERS_INSTALADO="/etc/sudoers.d/duna-deploy-buzon"
ENTRY_PREV="/usr/local/sbin/duna-deploy-buzon.prev"
# Leading dot: outside /etc/sudoers.d's own #includedir pattern, which skips
# any file beginning with "." -- this backup is never itself read as a rule.
SUDOERS_PREV="/etc/sudoers.d/.duna-deploy-buzon.prev"

usage() {
    echo "usage: duna-deploy-buzon {status|deploy [--dry-run]|entrar|rollback-script|" \
        "carpetas <id>|fijar-carpetas <id> <carpeta>...|fijar-carpetas <id> --todas}" >&2
    exit 2
}

# -- argument shape, checked BEFORE the EUID refusal, so a usage mistake is
# reported the same way whether or not the caller is root.
parse_args() {
    if [[ $# -lt 1 ]]; then
        usage
    fi
    SUBCOMMAND="$1"
    shift
    DRY_RUN=0
    # --internal-reexec is set only by autoactualizar's own re-exec of this
    # same script, never meant to be typed by a caller -- it just tells THIS
    # invocation to skip autoactualizar, so a re-exec never loops.
    REEXEC=0
    CARPETA_ID=""
    FIJAR_ID=""
    FIJAR_TODAS=0
    FIJAR_CARPETAS=()
    case "$SUBCOMMAND" in
        status | entrar | rollback-script)
            [[ $# -eq 0 ]] || usage
            ;;
        deploy)
            local arg
            for arg in "$@"; do
                case "$arg" in
                    --dry-run) DRY_RUN=1 ;;
                    --internal-reexec) REEXEC=1 ;;
                    *) usage ;;
                esac
            done
            ;;
        carpetas)
            [[ $# -eq 1 ]] || usage
            CARPETA_ID="$1"
            [[ "$CARPETA_ID" =~ $ID_FUENTE_RE ]] || usage
            ;;
        fijar-carpetas)
            [[ $# -ge 2 ]] || usage
            FIJAR_ID="$1"
            [[ "$FIJAR_ID" =~ $ID_FUENTE_RE ]] || usage
            shift
            if [[ $# -eq 1 && "$1" == "--todas" ]]; then
                FIJAR_TODAS=1
            else
                local carpeta
                for carpeta in "$@"; do
                    # "--todas" alongside other arguments is the ambiguous
                    # shape (remove everything AND keep some folder?) --
                    # refused by name, never read as a literal folder
                    # named "--todas" just because it fits $CARPETA_RE.
                    [[ "$carpeta" != "--todas" ]] || usage
                    [[ "$carpeta" =~ $CARPETA_RE ]] || usage
                    FIJAR_CARPETAS+=("$carpeta")
                done
                [[ ${#FIJAR_CARPETAS[@]} -gt 0 ]] || usage
            fi
            ;;
        *)
            usage
            ;;
    esac
}

require_root() {
    if [[ "$EUID" -ne 0 ]]; then
        echo "duna-deploy-buzon: refusing: must be run as root (EUID 0), e.g. via sudo" >&2
        exit 1
    fi
}

_owner_of() {
    stat -c %U "$1"
}

_desc_head_as_owner() {
    printf 'runuser -u "$(stat -c %%U %s)" -- git -C %s rev-parse HEAD' "$1" "$1"
}

_desc_pull_as_owner() {
    printf 'runuser -u "$(stat -c %%U %s)" -- git -C %s pull --ff-only' "$1" "$1"
}

# True (exit 0) when $2 (the pulled candidate) differs from $1 (the
# installed copy), or $1 does not exist yet. False (exit 1) when they are
# byte-identical. Read-only, no root required -- this is why it is its own
# function instead of being inlined into autoactualizar.
_archivo_cambio() {
    local instalado="$1" candidato="$2"
    [[ -f "$instalado" ]] || return 0
    ! cmp -s "$instalado" "$candidato"
}

# True (exit 0) only when $1 holds EXACTLY one non-comment, non-blank line,
# and that line is EXACTLY "<user> ALL=(root) NOPASSWD:
# /usr/local/sbin/duna-deploy-buzon" -- no wildcard, no second command, no
# ALL in the command position, nothing else in the file. Prints why on a
# refusal. Read-only, no root required -- a pure text check, deliberately
# kept separate from the `visudo -cf` syntax check below.
_forma_sudoers_es_estricta() {
    local archivo="$1"
    local lineas n
    lineas="$(grep -vE '^[[:space:]]*(#.*)?$' "$archivo" 2>/dev/null || true)"
    n=0
    if [[ -n "$lineas" ]]; then
        n="$(printf '%s\n' "$lineas" | grep -c '[^[:space:]]')"
    fi
    if [[ "$n" -ne 1 ]]; then
        echo "duna-deploy-buzon: refusing: sudoers fragment must hold exactly one rule (found $n)" >&2
        return 1
    fi
    if ! printf '%s\n' "$lineas" | grep -qE '^[A-Za-z_][A-Za-z0-9_-]*[[:space:]]+ALL=\(root\)[[:space:]]+NOPASSWD:[[:space:]]+/usr/local/sbin/duna-deploy-buzon$'; then
        echo "duna-deploy-buzon: refusing: sudoers rule must be exactly 'NOPASSWD: /usr/local/sbin/duna-deploy-buzon' -- no wildcard, no extra command, no ALL" >&2
        return 1
    fi
    return 0
}

# The autoactualizar step itself (HOST-AUTOACTUALIZAR-BUZON-1): compares the
# just-pulled copies of this script and its sudoers fragment against what is
# installed, refuses before installing anything if the sudoers fragment
# changed into something wider than one exact rule, prints a diff of
# whatever changed, keeps the previous installed copies, installs the new
# ones, and re-execs itself so the rest of THIS deploy runs under the new
# code. Called only from cmd_deploy's real (non-dry-run) branch, after the
# pull and before anything that depends on the new code.
autoactualizar() {
    local entry_pulled="$REPO/deploy/host/duna-deploy-buzon"
    local sudoers_pulled="$REPO/deploy/host/duna-deploy-buzon.sudoers"

    local cambio_entry=0 cambio_sudoers=0
    _archivo_cambio "$ENTRY_INSTALADO" "$entry_pulled" && cambio_entry=1
    _archivo_cambio "$SUDOERS_INSTALADO" "$sudoers_pulled" && cambio_sudoers=1

    if [[ "$cambio_entry" -eq 0 && "$cambio_sudoers" -eq 0 ]]; then
        echo "entry script: up to date"
        return 0
    fi

    if [[ "$cambio_sudoers" -eq 1 ]]; then
        if ! _forma_sudoers_es_estricta "$sudoers_pulled"; then
            echo "duna-deploy-buzon: refusing: deploy stopped before installing anything" >&2
            exit 1
        fi
        if ! visudo -cf "$sudoers_pulled" >/dev/null 2>&1; then
            echo "duna-deploy-buzon: refusing: visudo -cf rejected the pulled sudoers fragment; deploy stopped before installing anything" >&2
            exit 1
        fi
    fi

    if [[ "$cambio_entry" -eq 1 ]]; then
        echo "duna-deploy-buzon: entry script changed:"
        diff -u "$ENTRY_INSTALADO" "$entry_pulled" || true
    fi
    if [[ "$cambio_sudoers" -eq 1 ]]; then
        echo "duna-deploy-buzon: sudoers fragment changed:"
        diff -u "$SUDOERS_INSTALADO" "$sudoers_pulled" || true
    fi

    if [[ "$cambio_entry" -eq 1 && -f "$ENTRY_INSTALADO" ]]; then
        install -o root -g root -m 0755 "$ENTRY_INSTALADO" "$ENTRY_PREV"
    fi
    if [[ "$cambio_sudoers" -eq 1 && -f "$SUDOERS_INSTALADO" ]]; then
        install -o root -g root -m 0440 "$SUDOERS_INSTALADO" "$SUDOERS_PREV"
    fi

    if [[ "$cambio_entry" -eq 1 ]]; then
        install -o root -g root -m 0755 "$entry_pulled" "$ENTRY_INSTALADO"
    fi
    if [[ "$cambio_sudoers" -eq 1 ]]; then
        install -o root -g root -m 0440 "$sudoers_pulled" "$SUDOERS_INSTALADO"
    fi

    echo "duna-deploy-buzon: entry script updated; re-executing under the new copy"
    exec "$ENTRY_INSTALADO" deploy --internal-reexec
}

_desc_estado_health() {
    printf 'systemd-run --pipe --quiet --wait --uid=duna --gid=duna --property=EnvironmentFile=%s --property=EnvironmentFile=%s --property=WorkingDirectory=%s -- %s/.venv/bin/python -m duna_buzon estado' \
        "$ENV_CLIENTE" "$ENV_TOKEN" "$REPO" "$REPO"
}

# Read-only: never writes, never restarts, never installs anything. Shares
# its own health check with `deploy`'s final step below.
cmd_status() {
    local dry_run="$1"
    if [[ "$dry_run" == "1" ]]; then
        echo "+ $(_desc_head_as_owner "$REPO")"
        echo "+ systemctl is-active $SERVICIO"
        echo "+ systemctl is-active $TIMER"
        echo "+ $(_desc_estado_health)"
        return 0
    fi

    local owner
    owner="$(_owner_of "$REPO")"
    echo "repo HEAD: $(runuser -u "$owner" -- git -C "$REPO" rev-parse HEAD)"

    local valor_servicio valor_timer
    valor_servicio="$(systemctl is-active "$SERVICIO" 2>&1 || true)"
    valor_timer="$(systemctl is-active "$TIMER" 2>&1 || true)"
    echo "$SERVICIO: $valor_servicio"
    echo "$TIMER: $valor_timer"

    local estado_salida=0
    systemd-run --pipe --quiet --wait --uid=duna --gid=duna \
        --property="EnvironmentFile=$ENV_CLIENTE" --property="EnvironmentFile=$ENV_TOKEN" \
        --property="WorkingDirectory=$REPO" -- \
        "$REPO/.venv/bin/python" -m duna_buzon estado || estado_salida=$?
    if [[ "$estado_salida" -ne 0 ]]; then
        echo "duna-deploy-buzon: status check failed (python -m duna_buzon estado exited $estado_salida)" >&2
        exit 1
    fi
}

# Pulls as the owner, syncs as the owner, creates the data directory if
# missing (NEVER deletes it -- no backup subcommand either: see
# deploy/host/README.md, the data dir holds only a re-creatable cache and
# cursor), installs the two units, enables the timer, and finishes with
# the SAME health check `status` runs.
cmd_deploy() {
    local dry_run="$1"
    local reexec="${2:-0}"
    if [[ "$dry_run" == "1" ]]; then
        echo "+ $(_desc_head_as_owner "$REPO")"
        echo "+ $(_desc_pull_as_owner "$REPO")"
        echo "+ autoactualizar: compare $REPO/deploy/host/duna-deploy-buzon(.sudoers) against $ENTRY_INSTALADO / $SUDOERS_INSTALADO"
        echo "+ diff -u $ENTRY_INSTALADO $REPO/deploy/host/duna-deploy-buzon (only if the script changed)"
        echo "+ diff -u $SUDOERS_INSTALADO $REPO/deploy/host/duna-deploy-buzon.sudoers (only if the sudoers fragment changed)"
        echo "+ visudo -cf $REPO/deploy/host/duna-deploy-buzon.sudoers (only if the sudoers fragment changed)"
        echo "+ install -o root -g root -m 0755 $ENTRY_INSTALADO $ENTRY_PREV (only if the script changed)"
        echo "+ install -o root -g root -m 0440 $SUDOERS_INSTALADO $SUDOERS_PREV (only if the sudoers fragment changed)"
        echo "+ install -o root -g root -m 0755 $REPO/deploy/host/duna-deploy-buzon $ENTRY_INSTALADO (only if the script changed)"
        echo "+ install -o root -g root -m 0440 $REPO/deploy/host/duna-deploy-buzon.sudoers $SUDOERS_INSTALADO (only if the sudoers fragment changed)"
        echo "+ exec $ENTRY_INSTALADO deploy --internal-reexec (only if anything changed, so the rest of the deploy runs under the new code)"
        echo "+ runuser -u \"\$(stat -c %U $REPO)\" -- uv sync --frozen (cwd $REPO)"
        echo "+ install -d -o duna -g duna -m 0700 $DATOS_DIR"
        echo "+ install -o root -g root -m 644 $REPO/deploy/systemd/duna-buzon.service $UNIDADES_DIR/$SERVICIO"
        echo "+ install -o root -g root -m 644 $REPO/deploy/systemd/duna-buzon.timer $UNIDADES_DIR/$TIMER"
        echo "+ systemctl daemon-reload"
        echo "+ systemctl enable --now $TIMER"
        echo "+ $(_desc_estado_health)"
        return 0
    fi

    local owner before
    owner="$(_owner_of "$REPO")"
    before="$(runuser -u "$owner" -- git -C "$REPO" rev-parse HEAD)"
    echo "deploy: before=$before"
    runuser -u "$owner" -- git -C "$REPO" pull --ff-only

    if [[ "$reexec" != "1" ]]; then
        autoactualizar
    else
        echo "entry script: re-executed under the newly installed copy"
    fi

    runuser -u "$owner" -- env --chdir="$REPO" uv sync --frozen

    if [[ ! -d "$DATOS_DIR" ]]; then
        install -d -o duna -g duna -m 0700 "$DATOS_DIR"
    fi

    install -o root -g root -m 644 "$REPO/deploy/systemd/duna-buzon.service" "$UNIDADES_DIR/$SERVICIO"
    install -o root -g root -m 644 "$REPO/deploy/systemd/duna-buzon.timer" "$UNIDADES_DIR/$TIMER"
    systemctl daemon-reload
    systemctl enable --now "$TIMER"

    local estado_salida=0
    systemd-run --pipe --quiet --wait --uid=duna --gid=duna \
        --property="EnvironmentFile=$ENV_CLIENTE" --property="EnvironmentFile=$ENV_TOKEN" \
        --property="WorkingDirectory=$REPO" -- \
        "$REPO/.venv/bin/python" -m duna_buzon estado || estado_salida=$?
    if [[ "$estado_salida" -ne 0 ]]; then
        echo "duna-deploy-buzon: deploy health check failed (python -m duna_buzon estado exited $estado_salida)" >&2
        exit 1
    fi
}

# BUZON-CARPETAS-MICROSOFT-CLI-1 -- `fuente.json` carries no secret (see
# `fuentes.py`'s own docstring), so root reading it directly here, to pick
# which python subcommand answers `carpetas <id>`, is no different from
# root reading any other file on the host; the credential stays in its own
# `credencial.bin`, never touched by this function.
#
# `_proveedor_desde_archivo` is the pure, PATH-parameterized half (no root
# required to exercise it directly, same technique `_archivo_cambio`/
# `_forma_sudoers_es_estricta` already use above); `_proveedor_de_fuente`
# is the thin wrapper that resolves `$id` under `$DATOS_DIR` and turns a
# read failure into this script's own `exit 1` + message.
_proveedor_desde_archivo() {
    local archivo="$1"
    if [[ ! -f "$archivo" ]]; then
        echo "duna-deploy-buzon: refusing: no such source file: $archivo" >&2
        return 1
    fi
    local linea
    linea="$(grep -o '"proveedor"[[:space:]]*:[[:space:]]*"[a-z]*"' "$archivo" | head -n1 || true)"
    if [[ -z "$linea" ]]; then
        echo "duna-deploy-buzon: refusing: could not read the provider from: $archivo" >&2
        return 1
    fi
    echo "$linea" | sed -E 's/.*"([a-z]+)"$/\1/'
}

_proveedor_de_fuente() {
    local id="$1"
    local archivo="$DATOS_DIR/fuentes/$id/fuente.json"
    if [[ ! -f "$archivo" ]]; then
        echo "duna-deploy-buzon: refusing: no such source: $id" >&2
        exit 1
    fi
    _proveedor_desde_archivo "$archivo" || exit 1
}

# Read-only: `carpetas <id>` (imap or graph, by provider) -- never writes.
cmd_carpetas() {
    local id="$1"
    local proveedor subcomando_py
    proveedor="$(_proveedor_de_fuente "$id")"
    case "$proveedor" in
        imap) subcomando_py="carpetas" ;;
        microsoft) subcomando_py="carpetas-graph" ;;
        *)
            echo "duna-deploy-buzon: refusing: provider $proveedor has no carpetas listing" >&2
            exit 1
            ;;
    esac
    systemd-run --pipe --quiet --wait --uid=duna --gid=duna \
        --property="EnvironmentFile=$ENV_CLIENTE" --property="EnvironmentFile=$ENV_TOKEN" \
        --property="WorkingDirectory=$REPO" -- \
        "$REPO/.venv/bin/python" -m duna_buzon "$subcomando_py" "$id"
}

# `fijar-carpetas <id> <carpeta>...|--todas` -- each positional folder name
# becomes its own `--carpeta` argument to python, never a shell string;
# `python -m duna_buzon fijar-carpetas` itself validates the id and the
# provider and writes `fuente.json` atomically.
cmd_fijar_carpetas() {
    local id="$1" todas="$2"
    shift 2
    local -a comando=("$REPO/.venv/bin/python" "-m" "duna_buzon" "fijar-carpetas" "$id")
    if [[ "$todas" == "1" ]]; then
        comando+=("--todas")
    else
        local carpeta
        for carpeta in "$@"; do
            comando+=("--carpeta" "$carpeta")
        done
    fi
    systemd-run --pipe --quiet --wait --uid=duna --gid=duna \
        --property="EnvironmentFile=$ENV_CLIENTE" --property="EnvironmentFile=$ENV_TOKEN" \
        --property="WorkingDirectory=$REPO" -- "${comando[@]}"
}

# For Carlos, at his own terminal: never systemd-run, never --pty -- a real
# tty is already attached, and this just hands it straight to `duna`. `duna`
# cannot traverse /srv/duna/env/ on this host, so it can never source either
# env file by path itself -- ROOT opens both files here and hands them to
# the duna-owned child as already-open file descriptors (3 and 4), which
# the child sources from /dev/fd/N and then closes before exec'ing python.
# Never printed, never logged, never argv, so Config.desde_entorno's blanket
# requirement is satisfied even though this command itself never reads the
# Finanzas token. Refuses, before any of that, if `deploy` has never created
# the venv.
cmd_entrar() {
    if [[ ! -x "$REPO/.venv/bin/python" ]]; then
        echo "duna-deploy-buzon: refusing: run \`duna-deploy-buzon deploy\` first" >&2
        exit 1
    fi

    exec runuser -u duna -- /bin/bash -c '
        set -a
        . /dev/fd/3
        . /dev/fd/4
        set +a
        exec 3<&- 4<&-
        exec "'"$REPO"'/.venv/bin/python" -m duna_buzon entrar
    ' 3<"$ENV_CLIENTE" 4<"$ENV_TOKEN"
}

# Restores the installed entry script and/or sudoers fragment from the
# `.prev` copies autoactualizar kept, undoing its most recent install. A
# no-op left by autoactualizar never happening yet (no `.prev` copy at all)
# is refused by name, not silently treated as success.
cmd_rollback_script() {
    local restaurado=0
    if [[ -f "$ENTRY_PREV" ]]; then
        install -o root -g root -m 0755 "$ENTRY_PREV" "$ENTRY_INSTALADO"
        echo "duna-deploy-buzon: restored $ENTRY_INSTALADO from $ENTRY_PREV"
        restaurado=1
    fi
    if [[ -f "$SUDOERS_PREV" ]]; then
        install -o root -g root -m 0440 "$SUDOERS_PREV" "$SUDOERS_INSTALADO"
        echo "duna-deploy-buzon: restored $SUDOERS_INSTALADO from $SUDOERS_PREV"
        restaurado=1
    fi
    if [[ "$restaurado" -eq 0 ]]; then
        echo "duna-deploy-buzon: refusing: no previous copy found to roll back to" >&2
        exit 1
    fi
}

dispatch() {
    local subcommand="$1" dry_run="$2" reexec="$3"
    case "$subcommand" in
        status) cmd_status "$dry_run" ;;
        deploy) cmd_deploy "$dry_run" "$reexec" ;;
        entrar) cmd_entrar ;;
        rollback-script) cmd_rollback_script ;;
        carpetas) cmd_carpetas "$CARPETA_ID" ;;
        fijar-carpetas) cmd_fijar_carpetas "$FIJAR_ID" "$FIJAR_TODAS" "${FIJAR_CARPETAS[@]+"${FIJAR_CARPETAS[@]}"}" ;;
    esac
}

__main() {
    parse_args "$@"
    require_root
    dispatch "$SUBCOMMAND" "$DRY_RUN" "$REEXEC"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    __main "$@"
fi
