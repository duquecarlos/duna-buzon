#!/usr/bin/env bash
# duna-deploy-buzon -- BUZON-CONECTOR-1, under Main's own
# contracts/host-deploy-v1.md (ORCH-HOST-DEPLOY-V1). Installed once, by
# hand, by Carlos (deploy/host/README.md), and granted passwordless sudo
# for exactly this one path (deploy/host/duna-deploy-buzon.sudoers). Called
# as:
#
#   sudo -n /usr/local/sbin/duna-deploy-buzon status
#   sudo -n /usr/local/sbin/duna-deploy-buzon deploy [--dry-run]
#   sudo -n /usr/local/sbin/duna-deploy-buzon entrar
#   sudo -n /usr/local/sbin/duna-deploy-buzon rollback-script
#   sudo -n /usr/local/sbin/duna-deploy-buzon carpetas <id>
#   sudo -n /usr/local/sbin/duna-deploy-buzon fijar-carpetas <id> <carpeta>...
#   sudo -n /usr/local/sbin/duna-deploy-buzon fijar-carpetas <id> --todas
#   sudo -n /usr/local/sbin/duna-deploy-buzon registros <unidad> [n]
#   sudo -n /usr/local/sbin/duna-deploy-buzon rebobinar-cursor <id> <fecha> [--aplicar]
#   sudo -n /usr/local/sbin/duna-deploy-buzon reglas-ver <fuente>
#   sudo -n /usr/local/sbin/duna-deploy-buzon reglas <fuente> [--aplicar]
#   sudo -n /usr/local/sbin/duna-deploy-buzon env-tiene <CLAVE>
#   sudo -n /usr/local/sbin/duna-deploy-buzon env-set <CLAVE> <VALOR> [--aplicar]
#   sudo -n /usr/local/sbin/duna-deploy-buzon alertas
#
# BUZON-ALERTA-AUTH-1 -- `alertas` is read-only: it just runs `python -m
# duna_buzon alertas --json`, as `duna`, the same way `status` runs
# `estado` -- a JSON list of every source whose own credential has been
# failing to authenticate for more than BUZON_ALERTA_AUTH_HORAS (default
# 24) hours, `[]` when none. Main's own session-start hub check reads this
# over `sudo -n` (the sudoers rule below is a bare script path, so this
# subcommand needs no sudoers change) to relay a dead credential to the
# desk. Never a token, password or address beyond the source's own id.
#
# BUZON-REGLAS-ENTRADA-1 -- `reglas-ver <fuente>` prints a source's own
# `reglas.json`, read-only (never a secret: `reglas.json` holds only
# senders, domains and keywords). `reglas <fuente> [--aplicar]` reads a
# candidate `reglas.json` from stdin (at most 64 KiB), validates it with
# the PROGRAM's OWN loader -- `runuser -u duna -- .venv/bin/python -m
# duna_buzon validar-reglas`, the one python subcommand that builds no
# `Config` and touches no env file -- refuses whatever that loader
# refuses, prints a unified diff of the existing file against the
# candidate, and stops there unless `--aplicar` is given. `--aplicar`
# backs up the existing file to `reglas.json.<UTC stamp>.bak` beside it,
# writes the new one atomically (temp file in the same directory, then
# `mv`) as duna:duna mode 0600, and logs one count-only line (source id,
# old and new sha256, the backup's name -- never the rules' own content)
# via `logger -t duna-deploy-buzon`. Neither subcommand ever reads
# `credencial.bin`, the cursor, or either env file.
#
# `env-tiene <CLAVE>` works for ANY key shaped like an environment
# variable name and prints only `definida`/`no definida` against
# `$ENV_CLIENTE` -- never the value, so it is safe to run for a secret's
# own name too. `env-set <CLAVE> <VALOR> [--aplicar]` writes `$ENV_CLIENTE`
# but ONLY for a key listed in the allowlist this repo ships
# (`deploy/host/env-permitidas.json`, installed by autoactualizar below as
# `$ENV_PERMITIDAS_INSTALADO`, each key mapped to the one regex its value
# must match) -- and a hard, in-script denylist on the key's own NAME
# (`DENYLIST_SECRETO_RE`) is checked first and wins even over an
# allowlisted key, so a future allowlist entry that looks like a secret's
# name can never be used to write one. Dry-run by default, prints the
# current and the proposed value (safe: only an allowlisted, denylist-
# cleared key ever reaches this point), and `--aplicar` backs up
# `$ENV_CLIENTE`, changes EXACTLY the one matching line (or appends it)
# atomically, and logs one line via `logger -t duna-deploy-buzon` naming
# the key and the backup -- never the value. Neither subcommand ever
# restarts anything: the timer's next scheduled pass reads the file fresh.
#
# BUZON-CURSOR-REBOBINAR-CLI-1 -- `rebobinar-cursor <id> <fecha ISO>
# [--aplicar]` forwards straight to `python -m duna_buzon rebobinar-cursor`,
# dry-run by default. `<id>` and `<fecha>` are each checked against their own
# fixed regex before anything runs (ID_FUENTE_RE, FECHA_ISO_RE), and each
# reaches python as its own argv element, never a shell string. python itself
# refuses an unknown source, a future date, and a date more than 90 days
# back; this script only ever shapes and forwards the argv, never any of
# those decisions.
#
# BUZON-ENTRADA-UNIDADES-REGISTROS-1 -- `deploy` now diffs EVERY unit file
# under deploy/systemd/ (duna-buzon.service, duna-buzon.timer) against what
# is actually installed under /etc/systemd/system/, copying only the ones
# that differ, running exactly one `systemctl daemon-reload`, and printing
# each unit as "sin cambios" or "actualizada" -- so a unit that was never
# diffed before (only ever blindly overwritten) cannot drift silently.
# `status` gained a read-only drift line per unit ("coincide"/"distinta"/
# "falta"), the installed `User=` of the job unit, and the data directory's
# owner and mode -- and prints the main service's last 30 redacted journal
# lines automatically when it is "failed". `registros <unidad> [n]` is a
# read-only operator verb: <unidad> from a fixed allowlist of this repo's
# own units, n a positive integer capped at 200 (default 40), running
# exactly `journalctl -u <unidad> -n <n> --no-pager -o cat` piped through a
# redaction filter (postgres(ql):// credentials and
# (SECRET|TOKEN|PASSWORD|KEY)= values become ***) -- never interpolated into
# a shell string.
#
# `carpetas`/`fijar-carpetas` are BUZON-CARPETAS-MICROSOFT-CLI-1: operator
# tooling over `fuentes/<id>/fuente.json`'s own `carpetas` setting, which
# before this slice needed a hand edit as `duna` for a microsoft source.
# `carpetas <id>` reads the source's own `proveedor` from its `fuente.json`
# (never a secret, root can read it directly) and runs `python -m
# duna_buzon carpetas <id>` for an imap source or `carpetas-graph <id>` for
# a microsoft one -- both read-only, as `duna`. `fijar-carpetas <id>
# <carpeta>...` or `fijar-carpetas <id> --todas` forwards to `python -m
# duna_buzon fijar-carpetas`, translating each positional folder name into
# its own `--carpeta` argument -- every folder name reaches python as its
# own argv element, never built into a shell string.
#
# `entrar` is the one subcommand meant for Carlos himself, run directly in
# his own SSH terminal (not over a batch/no-tty session) -- it signs in
# interactively, printing Microsoft's device-code URL to whatever terminal
# called it, and so is the one subcommand that never uses systemd-run.
#
# `deploy` self-updates (HOST-AUTOACTUALIZAR-BUZON-1): right after the pull
# and before anything that depends on the new code, it compares the pulled
# copy of this script and its sudoers fragment against what is actually
# installed, prints a diff of whatever changed, refuses a sudoers fragment
# that is not EXACTLY one NOPASSWD rule on this one path, keeps the previous
# installed copies (`.prev`) so `rollback-script` can restore them, installs
# the new copies, and re-execs itself under the newly installed script --
# once, never looping -- so the rest of that same deploy runs under the new
# code. The FIRST install of a new version of this script is still manual
# (deploy/host/README.md's "Update" section) -- autoactualizar only takes
# over from the second `deploy` onward.
#
# Every path below is a CONSTANT, never taken from argv or the environment:
# the only things argv may select are the four subcommands, --dry-run, and
# --internal-reexec (set only by autoactualizar's own re-exec, never meant
# to be typed by a caller).
set -Eeuo pipefail

# Fixed PATH, independent of the caller's shell -- this script trusts no
# inherited environment variable for its own decisions.
PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

REPO="/srv/duna/repos/duna-buzon"
DATOS_DIR="/srv/duna/data/buzon"
ENV_CLIENTE="/srv/duna/env/buzon.env"
ENV_TOKEN="/srv/duna/env/buzon-conector.env"
SERVICIO="duna-buzon.service"
TIMER="duna-buzon.timer"
UNIDADES_DIR="/etc/systemd/system"

# BUZON-ENTRADA-UNIDADES-REGISTROS-1 -- every unit this repo ships, the
# subset of those that are timers (enabled --now on every deploy), and the
# subset that are job units (oneshot services -- the ones a drift report
# shows a `User=` for and whose last lines get auto-printed on failure).
# Also doubles as `registros`' own fixed allowlist: never taken from argv.
UNIDADES=("$SERVICIO" "$TIMER")
UNIDADES_TIMERS=("$TIMER")
UNIDADES_JOB=("$SERVICIO")

# BUZON-CARPETAS-MICROSOFT-CLI-1 -- the only two argument shapes `carpetas`
# and `fijar-carpetas` ever accept; every id and folder name is checked
# against these before anything runs, and is always passed on to python as
# its own argv element, never interpolated into a shell string.
ID_FUENTE_RE='^[a-z0-9-]+$'
CARPETA_RE='^[A-Za-z0-9_ .-]+$'

# BUZON-CURSOR-REBOBINAR-CLI-1 -- the one shape `rebobinar-cursor` ever
# accepts for its own `<fecha>` argument: a bare ISO date, or a full ISO
# timestamp with an optional fractional second and an optional `Z`/offset
# suffix. Checked before anything runs, same convention as ID_FUENTE_RE
# above; python itself still refuses a future date or one more than 90 days
# back -- this regex only shapes what reaches argv.
FECHA_ISO_RE='^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})?)?$'

# autoactualizar's own fixed paths (HOST-AUTOACTUALIZAR-BUZON-1) -- constants,
# like every other path above, never taken from argv or the environment.
ENTRY_INSTALADO="/usr/local/sbin/duna-deploy-buzon"
SUDOERS_INSTALADO="/etc/sudoers.d/duna-deploy-buzon"
ENTRY_PREV="/usr/local/sbin/duna-deploy-buzon.prev"
# Leading dot: outside /etc/sudoers.d's own #includedir pattern, which skips
# any file beginning with "." -- this backup is never itself read as a rule.
SUDOERS_PREV="/etc/sudoers.d/.duna-deploy-buzon.prev"
# BUZON-REGLAS-ENTRADA-1 -- `env-set`'s own allowlist, installed beside the
# entry script itself by autoactualizar, same as ENTRY_INSTALADO above.
ENV_PERMITIDAS_INSTALADO="/usr/local/sbin/duna-deploy-buzon-env-permitidas.json"

# BUZON-REGLAS-ENTRADA-1 -- the one shape `reglas`/`reglas-ver`'s own stdin
# cap and `env-tiene`/`env-set`'s own key name ever accept. A key is a
# plain uppercase environment-variable name; never taken loosely, same
# convention as every other *_RE constant above.
CLAVE_ENV_RE='^[A-Z][A-Z0-9_]*$'

# A hard, in-script denylist on an env-set key's own NAME -- checked even
# for a key the allowlist file names, so a future allowlist entry that
# merely LOOKS like a secret's name can never be used to write one
# through this passwordless path.
DENYLIST_SECRETO_RE='(TOKEN|SECRET|PASSWORD|CLAVE|_KEY|CIFRADO|CLIENT_ID|DSN|PRIVATE)'

# `reglas <fuente> [--aplicar]` never reads more than this many bytes from
# stdin -- a named constant, never a magic number (64 KiB).
LIMITE_REGLAS_BYTES=65536

usage() {
    echo "usage: duna-deploy-buzon {status|deploy [--dry-run]|entrar|rollback-script|" \
        "carpetas <id>|fijar-carpetas <id> <carpeta>...|fijar-carpetas <id> --todas|" \
        "registros <unidad> [n]|rebobinar-cursor <id> <fecha> [--aplicar]|" \
        "reglas-ver <fuente>|reglas <fuente> [--aplicar]|" \
        "env-tiene <clave>|env-set <clave> <valor> [--aplicar]|alertas}" >&2
    exit 2
}

# -- argument shape, checked BEFORE the EUID refusal, so a usage mistake is
# reported the same way whether or not the caller is root.
parse_args() {
    if [[ $# -lt 1 ]]; then
        usage
    fi
    SUBCOMMAND="$1"
    shift
    DRY_RUN=0
    # --internal-reexec is set only by autoactualizar's own re-exec of this
    # same script, never meant to be typed by a caller -- it just tells THIS
    # invocation to skip autoactualizar, so a re-exec never loops.
    REEXEC=0
    CARPETA_ID=""
    FIJAR_ID=""
    FIJAR_TODAS=0
    FIJAR_CARPETAS=()
    REGISTROS_UNIDAD=""
    REGISTROS_N=""
    REBOBINAR_ID=""
    REBOBINAR_FECHA=""
    REBOBINAR_APLICAR=0
    REGLAS_VER_ID=""
    REGLAS_ID=""
    REGLAS_APLICAR=0
    ENV_TIENE_CLAVE=""
    ENV_SET_CLAVE=""
    ENV_SET_VALOR=""
    ENV_SET_APLICAR=0
    case "$SUBCOMMAND" in
        status | entrar | rollback-script | alertas)
            [[ $# -eq 0 ]] || usage
            ;;
        deploy)
            local arg
            for arg in "$@"; do
                case "$arg" in
                    --dry-run) DRY_RUN=1 ;;
                    --internal-reexec) REEXEC=1 ;;
                    *) usage ;;
                esac
            done
            ;;
        carpetas)
            [[ $# -eq 1 ]] || usage
            CARPETA_ID="$1"
            [[ "$CARPETA_ID" =~ $ID_FUENTE_RE ]] || usage
            ;;
        registros)
            [[ $# -eq 1 || $# -eq 2 ]] || usage
            REGISTROS_UNIDAD="$1"
            _unidad_permitida "$REGISTROS_UNIDAD" || usage
            if [[ $# -eq 2 ]]; then
                REGISTROS_N="$(_normaliza_n "$2")" || usage
            else
                REGISTROS_N="$(_normaliza_n "")"
            fi
            ;;
        fijar-carpetas)
            [[ $# -ge 2 ]] || usage
            FIJAR_ID="$1"
            [[ "$FIJAR_ID" =~ $ID_FUENTE_RE ]] || usage
            shift
            if [[ $# -eq 1 && "$1" == "--todas" ]]; then
                FIJAR_TODAS=1
            else
                local carpeta
                for carpeta in "$@"; do
                    # "--todas" alongside other arguments is the ambiguous
                    # shape (remove everything AND keep some folder?) --
                    # refused by name, never read as a literal folder
                    # named "--todas" just because it fits $CARPETA_RE.
                    [[ "$carpeta" != "--todas" ]] || usage
                    [[ "$carpeta" =~ $CARPETA_RE ]] || usage
                    FIJAR_CARPETAS+=("$carpeta")
                done
                [[ ${#FIJAR_CARPETAS[@]} -gt 0 ]] || usage
            fi
            ;;
        rebobinar-cursor)
            [[ $# -eq 2 || $# -eq 3 ]] || usage
            REBOBINAR_ID="$1"
            [[ "$REBOBINAR_ID" =~ $ID_FUENTE_RE ]] || usage
            REBOBINAR_FECHA="$2"
            [[ "$REBOBINAR_FECHA" =~ $FECHA_ISO_RE ]] || usage
            if [[ $# -eq 3 ]]; then
                [[ "$3" == "--aplicar" ]] || usage
                REBOBINAR_APLICAR=1
            fi
            ;;
        reglas-ver)
            [[ $# -eq 1 ]] || usage
            REGLAS_VER_ID="$1"
            [[ "$REGLAS_VER_ID" =~ $ID_FUENTE_RE ]] || usage
            ;;
        reglas)
            [[ $# -eq 1 || $# -eq 2 ]] || usage
            REGLAS_ID="$1"
            [[ "$REGLAS_ID" =~ $ID_FUENTE_RE ]] || usage
            if [[ $# -eq 2 ]]; then
                [[ "$2" == "--aplicar" ]] || usage
                REGLAS_APLICAR=1
            fi
            ;;
        env-tiene)
            [[ $# -eq 1 ]] || usage
            ENV_TIENE_CLAVE="$1"
            [[ "$ENV_TIENE_CLAVE" =~ $CLAVE_ENV_RE ]] || usage
            ;;
        env-set)
            [[ $# -eq 2 || $# -eq 3 ]] || usage
            ENV_SET_CLAVE="$1"
            [[ "$ENV_SET_CLAVE" =~ $CLAVE_ENV_RE ]] || usage
            ENV_SET_VALOR="$2"
            # No literal newline -- this value becomes one line of a
            # `CLAVE=VALOR` env file; a newline in it would let it inject a
            # second, unrelated line.
            [[ "$ENV_SET_VALOR" != *$'\n'* ]] || usage
            if [[ $# -eq 3 ]]; then
                [[ "$3" == "--aplicar" ]] || usage
                ENV_SET_APLICAR=1
            fi
            ;;
        *)
            usage
            ;;
    esac
}

require_root() {
    if [[ "$EUID" -ne 0 ]]; then
        echo "duna-deploy-buzon: refusing: must be run as root (EUID 0), e.g. via sudo" >&2
        exit 1
    fi
}

_owner_of() {
    stat -c %U "$1"
}

_desc_head_as_owner() {
    printf 'runuser -u "$(stat -c %%U %s)" -- git -C %s rev-parse HEAD' "$1" "$1"
}

_desc_pull_as_owner() {
    printf 'runuser -u "$(stat -c %%U %s)" -- git -C %s pull --ff-only' "$1" "$1"
}

# True (exit 0) when $2 (the pulled candidate) differs from $1 (the
# installed copy), or $1 does not exist yet. False (exit 1) when they are
# byte-identical. Read-only, no root required -- this is why it is its own
# function instead of being inlined into autoactualizar.
_archivo_cambio() {
    local instalado="$1" candidato="$2"
    [[ -f "$instalado" ]] || return 0
    ! cmp -s "$instalado" "$candidato"
}

# "coincide" when the installed copy is byte-identical to the repo's own,
# "distinta" when it differs, "falta" when nothing is installed at all. Pure
# and read-only -- the drift line `status` prints for every unit.
_estado_unidad() {
    local instalado="$1" candidato="$2"
    if [[ ! -f "$instalado" ]]; then
        echo "falta"
        return 0
    fi
    if cmp -s "$instalado" "$candidato"; then
        echo "coincide"
    else
        echo "distinta"
    fi
}

# The installed unit's own `User=` line, or empty if the file is missing or
# carries none (a .timer has none). Pure, read-only, no root required.
_user_de_unidad() {
    local archivo="$1"
    [[ -f "$archivo" ]] || return 0
    grep -m1 -E '^User=' "$archivo" 2>/dev/null | cut -d= -f2- || true
}

# True (exit 0) only when $1 is exactly one of this repo's own unit names
# (UNIDADES, a fixed array above -- never a regex, never taken from argv
# beyond this membership check). `registros`' own allowlist.
_unidad_permitida() {
    local unidad="$1" candidata
    for candidata in "${UNIDADES[@]}"; do
        [[ "$unidad" == "$candidata" ]] && return 0
    done
    return 1
}

# Validates and caps `registros`' own `n`: empty -> 40 (the default); not a
# positive integer -> refuses (exit 1, nothing echoed); over 200 -> capped
# to 200. Pure -- echoes the resolved value on success, exit 1 on a bad
# shape, so a caller can write `N="$(_normaliza_n "$2")" || usage`.
_normaliza_n() {
    local valor="${1:-}"
    if [[ -z "$valor" ]]; then
        echo 40
        return 0
    fi
    if ! [[ "$valor" =~ ^[0-9]+$ ]] || [[ "$valor" -eq 0 ]]; then
        return 1
    fi
    if [[ "$valor" -gt 200 ]]; then
        echo 200
    else
        echo "$valor"
    fi
}

# Redacts a stream of journal lines: the credentials half of a
# postgres://.../postgresql://... URL, and the value of any
# ...SECRET=/...TOKEN=/...PASSWORD=/...KEY= assignment, each become "***".
# Pure text filter, stdin to stdout -- shared by `registros` and `status`'s
# own auto-print-on-failure.
_redactar() {
    sed -E \
        -e 's#(postgres(ql)?://)[^@[:space:]/]*@#\1***@#g' \
        -e 's/([A-Za-z0-9_]*(SECRET|TOKEN|PASSWORD|KEY)=)[^[:space:]]*/\1***/g'
}

# `n` redacted lines of `unidad`'s own journal, via journalctl's own `-u`
# selector -- never a shell string built from the unit name, and nothing
# else is ever read. Shared by `cmd_registros` and `status`'s own
# auto-print when the main service is "failed".
_mostrar_registros() {
    local unidad="$1" n="$2"
    journalctl -u "$unidad" -n "$n" --no-pager -o cat | _redactar
}

# True (exit 0) only when $1 holds EXACTLY one non-comment, non-blank line,
# and that line is EXACTLY "<user> ALL=(root) NOPASSWD:
# /usr/local/sbin/duna-deploy-buzon" -- no wildcard, no second command, no
# ALL in the command position, nothing else in the file. Prints why on a
# refusal. Read-only, no root required -- a pure text check, deliberately
# kept separate from the `visudo -cf` syntax check below.
_forma_sudoers_es_estricta() {
    local archivo="$1"
    local lineas n
    lineas="$(grep -vE '^[[:space:]]*(#.*)?$' "$archivo" 2>/dev/null || true)"
    n=0
    if [[ -n "$lineas" ]]; then
        n="$(printf '%s\n' "$lineas" | grep -c '[^[:space:]]')"
    fi
    if [[ "$n" -ne 1 ]]; then
        echo "duna-deploy-buzon: refusing: sudoers fragment must hold exactly one rule (found $n)" >&2
        return 1
    fi
    if ! printf '%s\n' "$lineas" | grep -qE '^[A-Za-z_][A-Za-z0-9_-]*[[:space:]]+ALL=\(root\)[[:space:]]+NOPASSWD:[[:space:]]+/usr/local/sbin/duna-deploy-buzon$'; then
        echo "duna-deploy-buzon: refusing: sudoers rule must be exactly 'NOPASSWD: /usr/local/sbin/duna-deploy-buzon' -- no wildcard, no extra command, no ALL" >&2
        return 1
    fi
    return 0
}

# The autoactualizar step itself (HOST-AUTOACTUALIZAR-BUZON-1): compares the
# just-pulled copies of this script and its sudoers fragment against what is
# installed, refuses before installing anything if the sudoers fragment
# changed into something wider than one exact rule, prints a diff of
# whatever changed, keeps the previous installed copies, installs the new
# ones, and re-execs itself so the rest of THIS deploy runs under the new
# code. Called only from cmd_deploy's real (non-dry-run) branch, after the
# pull and before anything that depends on the new code.
autoactualizar() {
    local antes="$1"
    local entry_pulled="$REPO/deploy/host/duna-deploy-buzon"
    local sudoers_pulled="$REPO/deploy/host/duna-deploy-buzon.sudoers"
    local permitidas_pulled="$REPO/deploy/host/env-permitidas.json"

    local cambio_entry=0 cambio_sudoers=0 cambio_permitidas=0
    _archivo_cambio "$ENTRY_INSTALADO" "$entry_pulled" && cambio_entry=1
    _archivo_cambio "$SUDOERS_INSTALADO" "$sudoers_pulled" && cambio_sudoers=1
    _archivo_cambio "$ENV_PERMITIDAS_INSTALADO" "$permitidas_pulled" && cambio_permitidas=1

    if [[ "$cambio_entry" -eq 0 && "$cambio_sudoers" -eq 0 && "$cambio_permitidas" -eq 0 ]]; then
        echo "entry script: up to date"
        return 0
    fi

    if [[ "$cambio_sudoers" -eq 1 ]]; then
        if ! _forma_sudoers_es_estricta "$sudoers_pulled"; then
            echo "duna-deploy-buzon: refusing: deploy stopped before installing anything" >&2
            exit 1
        fi
        if ! visudo -cf "$sudoers_pulled" >/dev/null 2>&1; then
            echo "duna-deploy-buzon: refusing: visudo -cf rejected the pulled sudoers fragment; deploy stopped before installing anything" >&2
            exit 1
        fi
    fi

    if [[ "$cambio_entry" -eq 1 ]]; then
        echo "duna-deploy-buzon: entry script changed:"
        diff -u "$ENTRY_INSTALADO" "$entry_pulled" || true
    fi
    if [[ "$cambio_sudoers" -eq 1 ]]; then
        echo "duna-deploy-buzon: sudoers fragment changed:"
        diff -u "$SUDOERS_INSTALADO" "$sudoers_pulled" || true
    fi
    if [[ "$cambio_permitidas" -eq 1 ]]; then
        echo "duna-deploy-buzon: env-set allowlist changed:"
        diff -u "$ENV_PERMITIDAS_INSTALADO" "$permitidas_pulled" || true
    fi

    if [[ "$cambio_entry" -eq 1 && -f "$ENTRY_INSTALADO" ]]; then
        install -o root -g root -m 0755 "$ENTRY_INSTALADO" "$ENTRY_PREV"
    fi
    if [[ "$cambio_sudoers" -eq 1 && -f "$SUDOERS_INSTALADO" ]]; then
        install -o root -g root -m 0440 "$SUDOERS_INSTALADO" "$SUDOERS_PREV"
    fi

    if [[ "$cambio_entry" -eq 1 ]]; then
        install -o root -g root -m 0755 "$entry_pulled" "$ENTRY_INSTALADO"
    fi
    if [[ "$cambio_sudoers" -eq 1 ]]; then
        install -o root -g root -m 0440 "$sudoers_pulled" "$SUDOERS_INSTALADO"
    fi
    if [[ "$cambio_permitidas" -eq 1 ]]; then
        install -o root -g root -m 0644 "$permitidas_pulled" "$ENV_PERMITIDAS_INSTALADO"
    fi

    echo "duna-deploy-buzon: entry script updated; re-executing under the new copy"
    export DUNA_AUTOACTUALIZAR_BEFORE_SHA="$antes"
    exec "$ENTRY_INSTALADO" deploy --internal-reexec
}

_desc_estado_health() {
    printf 'systemd-run --pipe --quiet --wait --uid=duna --gid=duna --property=EnvironmentFile=%s --property=EnvironmentFile=%s --property=WorkingDirectory=%s -- %s/.venv/bin/python -m duna_buzon estado' \
        "$ENV_CLIENTE" "$ENV_TOKEN" "$REPO" "$REPO"
}

_desc_revertir_despliegue() {
    printf '(on failure only) runuser -u "$owner" -- git -C %s reset --hard <before-sha>; runuser -u "$owner" -- env --chdir=%s uv sync --frozen; re-run the health check; print "rolled back to <before-sha>: healthy" or "rolled back to <before-sha>: STILL UNHEALTHY"; exit non-zero either way (never touches %s)' \
        "$REPO" "$REPO" "$DATOS_DIR"
}

# Runs the one pass this product calls "health" -- `python -m duna_buzon
# estado` via systemd-run, as `duna`, with both env files -- and returns its
# exit code. Shared by `status`, `deploy`'s own final check and
# `revertir_despliegue`'s own re-check below, so all three agree on exactly
# what "healthy" means.
_chequear_salud() {
    local salida=0
    systemd-run --pipe --quiet --wait --uid=duna --gid=duna \
        --property="EnvironmentFile=$ENV_CLIENTE" --property="EnvironmentFile=$ENV_TOKEN" \
        --property="WorkingDirectory=$REPO" -- \
        "$REPO/.venv/bin/python" -m duna_buzon estado || salida=$?
    return "$salida"
}

# BUZON-DEPLOY-REVIERTE-SOLO-1 -- runs ONLY when `cmd_deploy`'s own health
# check fails: reverts the CODE to $2 (the sha `cmd_deploy` captured before
# this run's pull -- the real one even across autoactualizar's own re-exec,
# carried through DUNA_AUTOACTUALIZAR_BEFORE_SHA), re-syncs the environment
# and re-runs the SAME health check once more. NEVER touches $DATOS_DIR --
# cursors, the token cache and estado.json are left exactly as this run left
# them; a bad PASS (not a bad deploy) is `rebobinar-cursor`'s job, not this
# one's. Prints exactly one line and always exits non-zero -- a rollback
# that restores the service is still a failed deploy.
revertir_despliegue() {
    local owner="$1" antes="$2"
    echo "duna-deploy-buzon: deploy health check failed -- reverting code to $antes (cursors and state files under $DATOS_DIR are left as-is; see rebobinar-cursor for a bad pass)" >&2
    runuser -u "$owner" -- git -C "$REPO" reset --hard "$antes"
    runuser -u "$owner" -- env --chdir="$REPO" uv sync --frozen
    local revertido_salida=0
    _chequear_salud || revertido_salida=$?
    if [[ "$revertido_salida" -eq 0 ]]; then
        echo "rolled back to $antes: healthy"
    else
        echo "rolled back to $antes: STILL UNHEALTHY"
    fi
    exit 1
}

# Read-only: never writes, never restarts, never installs anything. Shares
# its own health check with `deploy`'s final step below.
cmd_status() {
    local dry_run="$1"
    if [[ "$dry_run" == "1" ]]; then
        echo "+ $(_desc_head_as_owner "$REPO")"
        echo "+ systemctl is-active $SERVICIO"
        echo "+ systemctl is-active $TIMER"
        echo "+ journalctl -u $SERVICIO -n 30 --no-pager -o cat | redact (only if $SERVICIO is failed)"
        echo "+ compare $UNIDADES_DIR/$SERVICIO against $REPO/deploy/systemd/$SERVICIO (coincide/distinta/falta)"
        echo "+ compare $UNIDADES_DIR/$TIMER against $REPO/deploy/systemd/$TIMER (coincide/distinta/falta)"
        echo "+ grep '^User=' $UNIDADES_DIR/$SERVICIO"
        echo "+ stat $DATOS_DIR (owner and mode)"
        echo "+ $(_desc_estado_health)"
        return 0
    fi

    local owner
    owner="$(_owner_of "$REPO")"
    echo "repo HEAD: $(runuser -u "$owner" -- git -C "$REPO" rev-parse HEAD)"

    local valor_timer
    valor_timer="$(systemctl is-active "$TIMER" 2>&1 || true)"
    echo "$TIMER: $valor_timer"

    local unidad valor
    for unidad in "${UNIDADES_JOB[@]}"; do
        valor="$(systemctl is-active "$unidad" 2>&1 || true)"
        echo "$unidad: $valor"
        if [[ "$valor" == "failed" ]]; then
            echo "$unidad: last 30 lines (redacted):"
            _mostrar_registros "$unidad" 30
        fi
    done

    for unidad in "${UNIDADES[@]}"; do
        echo "$unidad: $(_estado_unidad "$UNIDADES_DIR/$unidad" "$REPO/deploy/systemd/$unidad")"
    done

    local usuario
    for unidad in "${UNIDADES_JOB[@]}"; do
        usuario="$(_user_de_unidad "$UNIDADES_DIR/$unidad")"
        echo "$unidad User=: ${usuario:-<sin instalar>}"
    done

    if [[ -d "$DATOS_DIR" ]]; then
        echo "$DATOS_DIR: owner=$(stat -c '%U:%G' "$DATOS_DIR") mode=$(stat -c '%a' "$DATOS_DIR")"
    else
        echo "$DATOS_DIR: <no existe>"
    fi

    local estado_salida=0
    _chequear_salud || estado_salida=$?
    if [[ "$estado_salida" -ne 0 ]]; then
        echo "duna-deploy-buzon: status check failed (python -m duna_buzon estado exited $estado_salida)" >&2
        exit 1
    fi
}

# Pulls as the owner, syncs as the owner, creates the data directory if
# missing (NEVER deletes it -- no backup subcommand either: see
# deploy/host/README.md, the data dir holds only a re-creatable cache and
# cursor), installs the two units, enables the timer, and finishes with
# the SAME health check `status` runs.
cmd_deploy() {
    local dry_run="$1"
    local reexec="${2:-0}"
    if [[ "$dry_run" == "1" ]]; then
        echo "+ $(_desc_head_as_owner "$REPO")"
        echo "+ $(_desc_pull_as_owner "$REPO")"
        echo "+ autoactualizar: compare $REPO/deploy/host/duna-deploy-buzon(.sudoers) against $ENTRY_INSTALADO / $SUDOERS_INSTALADO"
        echo "+ diff -u $ENTRY_INSTALADO $REPO/deploy/host/duna-deploy-buzon (only if the script changed)"
        echo "+ diff -u $SUDOERS_INSTALADO $REPO/deploy/host/duna-deploy-buzon.sudoers (only if the sudoers fragment changed)"
        echo "+ visudo -cf $REPO/deploy/host/duna-deploy-buzon.sudoers (only if the sudoers fragment changed)"
        echo "+ diff -u $ENV_PERMITIDAS_INSTALADO $REPO/deploy/host/env-permitidas.json (only if the allowlist changed)"
        echo "+ install -o root -g root -m 0755 $ENTRY_INSTALADO $ENTRY_PREV (only if the script changed)"
        echo "+ install -o root -g root -m 0440 $SUDOERS_INSTALADO $SUDOERS_PREV (only if the sudoers fragment changed)"
        echo "+ install -o root -g root -m 0755 $REPO/deploy/host/duna-deploy-buzon $ENTRY_INSTALADO (only if the script changed)"
        echo "+ install -o root -g root -m 0440 $REPO/deploy/host/duna-deploy-buzon.sudoers $SUDOERS_INSTALADO (only if the sudoers fragment changed)"
        echo "+ install -o root -g root -m 0644 $REPO/deploy/host/env-permitidas.json $ENV_PERMITIDAS_INSTALADO (only if the allowlist changed)"
        echo "+ exec $ENTRY_INSTALADO deploy --internal-reexec (only if anything changed, so the rest of the deploy runs under the new code)"
        echo "+ runuser -u \"\$(stat -c %U $REPO)\" -- uv sync --frozen (cwd $REPO)"
        echo "+ install -d -o duna -g duna -m 0700 $DATOS_DIR"
        echo "+ compare $REPO/deploy/systemd/$SERVICIO against $UNIDADES_DIR/$SERVICIO (install -o root -g root -m 644 only if different; print sin cambios/actualizada)"
        echo "+ compare $REPO/deploy/systemd/$TIMER against $UNIDADES_DIR/$TIMER (install -o root -g root -m 644 only if different; print sin cambios/actualizada)"
        echo "+ systemctl daemon-reload"
        echo "+ systemctl enable --now $TIMER"
        echo "+ $(_desc_estado_health)"
        echo "+ $(_desc_revertir_despliegue)"
        return 0
    fi

    local owner before
    owner="$(_owner_of "$REPO")"
    if [[ -n "${DUNA_AUTOACTUALIZAR_BEFORE_SHA:-}" ]]; then
        before="$DUNA_AUTOACTUALIZAR_BEFORE_SHA"
        echo "deploy: before=$before (carried across re-exec)"
    else
        before="$(runuser -u "$owner" -- git -C "$REPO" rev-parse HEAD)"
        echo "deploy: before=$before"
    fi
    runuser -u "$owner" -- git -C "$REPO" pull --ff-only

    if [[ "$reexec" != "1" ]]; then
        autoactualizar "$before"
    else
        echo "entry script: re-executed under the newly installed copy"
    fi

    runuser -u "$owner" -- env --chdir="$REPO" uv sync --frozen

    if [[ ! -d "$DATOS_DIR" ]]; then
        install -d -o duna -g duna -m 0700 "$DATOS_DIR"
    fi

    local unidad
    for unidad in "${UNIDADES[@]}"; do
        local pulled="$REPO/deploy/systemd/$unidad"
        local instalada="$UNIDADES_DIR/$unidad"
        if _archivo_cambio "$instalada" "$pulled"; then
            install -o root -g root -m 644 "$pulled" "$instalada"
            echo "$unidad: actualizada"
        else
            echo "$unidad: sin cambios"
        fi
    done
    systemctl daemon-reload
    for unidad in "${UNIDADES_TIMERS[@]}"; do
        systemctl enable --now "$unidad"
    done

    local estado_salida=0
    _chequear_salud || estado_salida=$?
    if [[ "$estado_salida" -ne 0 ]]; then
        echo "duna-deploy-buzon: deploy health check failed (python -m duna_buzon estado exited $estado_salida)" >&2
        revertir_despliegue "$owner" "$before"
    fi
}

# BUZON-CARPETAS-MICROSOFT-CLI-1 -- `fuente.json` carries no secret (see
# `fuentes.py`'s own docstring), so root reading it directly here, to pick
# which python subcommand answers `carpetas <id>`, is no different from
# root reading any other file on the host; the credential stays in its own
# `credencial.bin`, never touched by this function.
#
# `_proveedor_desde_archivo` is the pure, PATH-parameterized half (no root
# required to exercise it directly, same technique `_archivo_cambio`/
# `_forma_sudoers_es_estricta` already use above); `_proveedor_de_fuente`
# is the thin wrapper that resolves `$id` under `$DATOS_DIR` and turns a
# read failure into this script's own `exit 1` + message.
_proveedor_desde_archivo() {
    local archivo="$1"
    if [[ ! -f "$archivo" ]]; then
        echo "duna-deploy-buzon: refusing: no such source file: $archivo" >&2
        return 1
    fi
    local linea
    linea="$(grep -o '"proveedor"[[:space:]]*:[[:space:]]*"[a-z]*"' "$archivo" | head -n1 || true)"
    if [[ -z "$linea" ]]; then
        echo "duna-deploy-buzon: refusing: could not read the provider from: $archivo" >&2
        return 1
    fi
    echo "$linea" | sed -E 's/.*"([a-z]+)"$/\1/'
}

_proveedor_de_fuente() {
    local id="$1"
    local archivo="$DATOS_DIR/fuentes/$id/fuente.json"
    if [[ ! -f "$archivo" ]]; then
        echo "duna-deploy-buzon: refusing: no such source: $id" >&2
        exit 1
    fi
    _proveedor_desde_archivo "$archivo" || exit 1
}

# BUZON-REGLAS-ENTRADA-1 -- true (exit 0) only when $1 (a string, never
# stdin itself: the caller already capped the READ) is strictly more than
# $2 bytes. Measures BYTES, not characters -- `wc -c` on `printf`'s own
# output, so a multi-byte UTF-8 character (accented Spanish text in a
# `palabras` entry) is never undercounted. Pure, no root required.
_excede_limite_bytes() {
    local contenido="$1" limite="$2" tam
    tam="$(printf '%s' "$contenido" | wc -c)"
    [[ "$tam" -gt "$limite" ]]
}

# Reads `fuentes/<id>/` directly under $DATOS_DIR and refuses by name if
# the source directory, or its own `reglas.json`, does not exist -- the
# one check `reglas-ver` and `reglas` share before doing anything else.
_requiere_reglas_existentes() {
    local id="$1"
    local directorio="$DATOS_DIR/fuentes/$id"
    if [[ ! -d "$directorio" ]]; then
        echo "duna-deploy-buzon: refusing: no such source: $id" >&2
        exit 1
    fi
    if [[ ! -f "$directorio/reglas.json" ]]; then
        echo "duna-deploy-buzon: refusing: no reglas.json for source: $id" >&2
        exit 1
    fi
    echo "$directorio/reglas.json"
}

# Read-only: prints a source's own `reglas.json` as-is -- never a secret
# (BUZON-REGLAS-ENTRADA-1's own invariant: `reglas.json` holds only
# senders, domains and keywords). `$(<"$archivo")` is bash's own builtin
# file-read, deliberately never the external coreutils concatenation
# command -- this script is checked elsewhere to never call that command
# at all, the same guard that keeps either env file from ever being read
# that way.
cmd_reglas_ver() {
    local id="$1"
    local archivo
    archivo="$(_requiere_reglas_existentes "$id")"
    printf '%s\n' "$(<"$archivo")"
}

# `reglas <fuente> [--aplicar]` -- reads at most LIMITE_REGLAS_BYTES bytes
# of a candidate `reglas.json` from stdin, validates it with the PROGRAM's
# own loader (never a shell re-implementation), prints a unified diff
# against the existing file, and only WRITES anything with --aplicar:
# backs up the old file, writes the new one atomically as duna:duna mode
# 0600, and logs one count-only line.
cmd_reglas() {
    local id="$1" aplicar="$2"
    local archivo
    archivo="$(_requiere_reglas_existentes "$id")"

    if [[ ! -x "$REPO/.venv/bin/python" ]]; then
        echo "duna-deploy-buzon: refusing: run \`duna-deploy-buzon deploy\` first" >&2
        exit 1
    fi

    # The sentinel-and-strip trick below (append "x", strip it after
    # capture) is what lets `nuevo` keep a trailing newline that bash's own
    # "$(...)" would otherwise silently drop -- without it, the byte count
    # below could undercount stdin's own real size.
    local nuevo
    nuevo="$(head -c "$((LIMITE_REGLAS_BYTES + 1))"; printf 'x')"
    nuevo="${nuevo%x}"
    if _excede_limite_bytes "$nuevo" "$LIMITE_REGLAS_BYTES"; then
        echo "duna-deploy-buzon: refusing: stdin exceeds $LIMITE_REGLAS_BYTES bytes" >&2
        exit 1
    fi

    local validacion
    if ! validacion="$(printf '%s' "$nuevo" | runuser -u duna -- "$REPO/.venv/bin/python" -m duna_buzon validar-reglas 2>&1)"; then
        echo "duna-deploy-buzon: refusing: invalid reglas.json" >&2
        printf '%s\n' "$validacion" >&2
        exit 1
    fi

    echo "duna-deploy-buzon: reglas diff for $id (old vs new):"
    diff -u "$archivo" <(printf '%s' "$nuevo") || true

    if [[ "$aplicar" != "1" ]]; then
        echo "duna-deploy-buzon: dry-run: nothing written (pass --aplicar to write)"
        return 0
    fi

    local estampa respaldo tmp sha_antes sha_despues
    estampa="$(date -u +%Y%m%dT%H%M%SZ)"
    respaldo="$(dirname "$archivo")/reglas.json.$estampa.bak"
    sha_antes="$(sha256sum "$archivo" | cut -d' ' -f1)"
    install -o duna -g duna -m 0600 "$archivo" "$respaldo"

    tmp="$(mktemp "$(dirname "$archivo")/.reglas.json.tmp.XXXXXX")"
    printf '%s' "$nuevo" > "$tmp"
    chown duna:duna "$tmp"
    chmod 0600 "$tmp"
    sha_despues="$(sha256sum "$tmp" | cut -d' ' -f1)"
    mv -f "$tmp" "$archivo"

    logger -t duna-deploy-buzon "reglas fuente=$id old_sha256=$sha_antes new_sha256=$sha_despues respaldo=$(basename "$respaldo")"
    echo "duna-deploy-buzon: reglas updated for $id (backup: $(basename "$respaldo"))"
}

# True (exit 0) only when $1 (an already CLAVE_ENV_RE-shaped key) matches
# the hard secret-name denylist -- checked even for a key the allowlist
# file names, so a future allowlist entry that merely LOOKS like a
# secret's name can never be used to write one. Pure, no root required.
_clave_es_secreta() {
    local clave="$1"
    [[ "$clave" =~ $DENYLIST_SECRETO_RE ]]
}

# Echoes the one regex $2 must match to be written for key $1, read from
# the allowlist file $archivo -- a flat `{"CLAVE": "patron", ...}` JSON
# object, parsed the same text-extraction way `_proveedor_desde_archivo`
# already reads a `"proveedor"` field, never a shell `eval` of the JSON.
# Refuses (exit 1, nothing echoed but the message) when the file or the
# key is missing.
_patron_permitido() {
    local archivo="$1" clave="$2"
    if [[ ! -f "$archivo" ]]; then
        echo "duna-deploy-buzon: refusing: no such allowlist file: $archivo" >&2
        return 1
    fi
    local linea
    linea="$(grep -o "\"$clave\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" "$archivo" | head -n1 || true)"
    if [[ -z "$linea" ]]; then
        echo "duna-deploy-buzon: refusing: $clave is not in the allowlist" >&2
        return 1
    fi
    echo "$linea" | sed -E 's/.*:[[:space:]]*"([^"]*)"$/\1/'
}

# Echoes $clave's own current value in $archivo (never printed labelled as
# a secret by any caller of this function; env-set only ever reaches it
# for an allowlisted, denylist-cleared key), or nothing if the file or the
# line does not exist. Pure, read-only, no root required.
_valor_env_actual() {
    local archivo="$1" clave="$2"
    [[ -f "$archivo" ]] || return 0
    grep -m1 -E "^${clave}=" "$archivo" 2>/dev/null | cut -d= -f2- || true
}

# True (exit 0) only when $archivo has an uncommented `$clave=...` line.
# Shares `_valor_env_actual` so `env-tiene` and `env-set`'s own "before"
# report agree byte-for-byte on what "defined" means.
_env_tiene_clave() {
    local archivo="$1" clave="$2"
    [[ -n "$(_valor_env_actual "$archivo" "$clave")" ]]
}

# Echoes $archivo's own lines to stdout, with the first `$clave=...` line
# replaced by `$clave=$valor` -- or, if no such line exists, with
# `$clave=$valor` appended at the end. The caller redirects this into a
# temp file and renames it over $archivo, so the real file is never
# written line-by-line in place. A comment line (`# CLAVE=...`) never
# matches, by construction (`==` here is a prefix glob on the RAW line,
# never on a stripped/trimmed one).
_escribir_env_con_clave() {
    local archivo="$1" clave="$2" valor="$3"
    local encontrada=0
    local linea
    if [[ -f "$archivo" ]]; then
        while IFS= read -r linea || [[ -n "$linea" ]]; do
            if [[ "$linea" == "$clave="* ]]; then
                printf '%s=%s\n' "$clave" "$valor"
                encontrada=1
            else
                printf '%s\n' "$linea"
            fi
        done < "$archivo"
    fi
    if [[ "$encontrada" -eq 0 ]]; then
        printf '%s=%s\n' "$clave" "$valor"
    fi
}

# Read-only: `env-tiene <clave>` -- works for ANY CLAVE_ENV_RE-shaped key,
# including a secret's own name, and prints only whether it is defined.
# Never the value, by construction: `_valor_env_actual`'s own result is
# used only for a length check here, never echoed.
cmd_env_tiene() {
    local clave="$1"
    if _env_tiene_clave "$ENV_CLIENTE" "$clave"; then
        echo "duna-deploy-buzon: $clave definida"
    else
        echo "duna-deploy-buzon: $clave no definida"
    fi
}

# `env-set <clave> <valor> [--aplicar]` -- writes $ENV_CLIENTE, but ONLY
# for a key the allowlist names and whose value matches that key's own
# pattern; the hard denylist on the key's NAME is checked first and wins
# even over the allowlist. Dry-run by default; `--aplicar` backs up the
# file, changes exactly the one matching line (or appends it) atomically,
# and logs one line -- never the value.
cmd_env_set() {
    local clave="$1" valor="$2" aplicar="$3"
    if _clave_es_secreta "$clave"; then
        echo "duna-deploy-buzon: refusing: $clave looks like a secret's own name; env-set never touches it" >&2
        exit 1
    fi

    local patron
    patron="$(_patron_permitido "$ENV_PERMITIDAS_INSTALADO" "$clave")" || exit 1
    if ! [[ "$valor" =~ $patron ]]; then
        echo "duna-deploy-buzon: refusing: value for $clave does not match its allowed pattern" >&2
        exit 1
    fi

    local actual
    actual="$(_valor_env_actual "$ENV_CLIENTE" "$clave")"
    echo "duna-deploy-buzon: $clave actual=${actual:-<no definida>}"
    echo "duna-deploy-buzon: $clave nuevo=$valor"

    if [[ "$aplicar" != "1" ]]; then
        echo "duna-deploy-buzon: dry-run: nothing written (pass --aplicar to write)"
        return 0
    fi

    local estampa respaldo tmp
    estampa="$(date -u +%Y%m%dT%H%M%SZ)"
    respaldo="$ENV_CLIENTE.$estampa.bak"
    install -o duna -g duna -m 0600 "$ENV_CLIENTE" "$respaldo"

    tmp="$(mktemp "$(dirname "$ENV_CLIENTE")/.buzon.env.tmp.XXXXXX")"
    _escribir_env_con_clave "$ENV_CLIENTE" "$clave" "$valor" > "$tmp"
    chown duna:duna "$tmp"
    chmod 0600 "$tmp"
    mv -f "$tmp" "$ENV_CLIENTE"

    logger -t duna-deploy-buzon "env-set clave=$clave respaldo=$(basename "$respaldo")"
    echo "duna-deploy-buzon: $clave updated (backup: $(basename "$respaldo"))"
}

# Read-only: `alertas` -- `python -m duna_buzon alertas --json`, as `duna`,
# the same `systemd-run --pipe --quiet --wait` shape `status`'s own health
# check uses. Prints whatever that JSON list is, `[]` when no source is in
# alerta; never writes anything (BUZON-ALERTA-AUTH-1).
cmd_alertas() {
    systemd-run --pipe --quiet --wait --uid=duna --gid=duna \
        --property="EnvironmentFile=$ENV_CLIENTE" --property="EnvironmentFile=$ENV_TOKEN" \
        --property="WorkingDirectory=$REPO" -- \
        "$REPO/.venv/bin/python" -m duna_buzon alertas --json
}

# Read-only: `carpetas <id>` (imap or graph, by provider) -- never writes.
cmd_carpetas() {
    local id="$1"
    local proveedor subcomando_py
    proveedor="$(_proveedor_de_fuente "$id")"
    case "$proveedor" in
        imap) subcomando_py="carpetas" ;;
        microsoft) subcomando_py="carpetas-graph" ;;
        *)
            echo "duna-deploy-buzon: refusing: provider $proveedor has no carpetas listing" >&2
            exit 1
            ;;
    esac
    systemd-run --pipe --quiet --wait --uid=duna --gid=duna \
        --property="EnvironmentFile=$ENV_CLIENTE" --property="EnvironmentFile=$ENV_TOKEN" \
        --property="WorkingDirectory=$REPO" -- \
        "$REPO/.venv/bin/python" -m duna_buzon "$subcomando_py" "$id"
}

# `fijar-carpetas <id> <carpeta>...|--todas` -- each positional folder name
# becomes its own `--carpeta` argument to python, never a shell string;
# `python -m duna_buzon fijar-carpetas` itself validates the id and the
# provider and writes `fuente.json` atomically.
cmd_fijar_carpetas() {
    local id="$1" todas="$2"
    shift 2
    local -a comando=("$REPO/.venv/bin/python" "-m" "duna_buzon" "fijar-carpetas" "$id")
    if [[ "$todas" == "1" ]]; then
        comando+=("--todas")
    else
        local carpeta
        for carpeta in "$@"; do
            comando+=("--carpeta" "$carpeta")
        done
    fi
    systemd-run --pipe --quiet --wait --uid=duna --gid=duna \
        --property="EnvironmentFile=$ENV_CLIENTE" --property="EnvironmentFile=$ENV_TOKEN" \
        --property="WorkingDirectory=$REPO" -- "${comando[@]}"
}

# Read-only: `registros <unidad> [n]` -- `unidad` was already checked
# against the UNIDADES allowlist and `n` already normalized in parse_args,
# so this just runs the fixed journalctl call and redacts it.
cmd_registros() {
    local unidad="$1" n="$2"
    _mostrar_registros "$unidad" "$n"
}

# `rebobinar-cursor <id> <fecha> [--aplicar]` -- forwards straight to
# `python -m duna_buzon rebobinar-cursor`, each argument its own argv
# element, never a shell string. Dry-run by default; python itself refuses
# an unknown source, a future date, and a date more than 90 days back
# (BUZON-CURSOR-REBOBINAR-CLI-1).
cmd_rebobinar_cursor() {
    local id="$1" fecha="$2" aplicar="$3"
    local -a comando=("$REPO/.venv/bin/python" "-m" "duna_buzon" "rebobinar-cursor" "$id" "$fecha")
    if [[ "$aplicar" == "1" ]]; then
        comando+=("--aplicar")
    fi
    systemd-run --pipe --quiet --wait --uid=duna --gid=duna \
        --property="EnvironmentFile=$ENV_CLIENTE" --property="EnvironmentFile=$ENV_TOKEN" \
        --property="WorkingDirectory=$REPO" -- "${comando[@]}"
}

# For Carlos, at his own terminal: never systemd-run, never --pty -- a real
# tty is already attached, and this just hands it straight to `duna`. `duna`
# cannot traverse /srv/duna/env/ on this host, so it can never source either
# env file by path itself -- ROOT opens both files here and hands them to
# the duna-owned child as already-open file descriptors (3 and 4), which
# the child sources from /dev/fd/N and then closes before exec'ing python.
# Never printed, never logged, never argv, so Config.desde_entorno's blanket
# requirement is satisfied even though this command itself never reads the
# Finanzas token. Refuses, before any of that, if `deploy` has never created
# the venv.
cmd_entrar() {
    if [[ ! -x "$REPO/.venv/bin/python" ]]; then
        echo "duna-deploy-buzon: refusing: run \`duna-deploy-buzon deploy\` first" >&2
        exit 1
    fi

    exec runuser -u duna -- /bin/bash -c '
        set -a
        . /dev/fd/3
        . /dev/fd/4
        set +a
        exec 3<&- 4<&-
        exec "'"$REPO"'/.venv/bin/python" -m duna_buzon entrar
    ' 3<"$ENV_CLIENTE" 4<"$ENV_TOKEN"
}

# Restores the installed entry script and/or sudoers fragment from the
# `.prev` copies autoactualizar kept, undoing its most recent install. A
# no-op left by autoactualizar never happening yet (no `.prev` copy at all)
# is refused by name, not silently treated as success.
cmd_rollback_script() {
    local restaurado=0
    if [[ -f "$ENTRY_PREV" ]]; then
        install -o root -g root -m 0755 "$ENTRY_PREV" "$ENTRY_INSTALADO"
        echo "duna-deploy-buzon: restored $ENTRY_INSTALADO from $ENTRY_PREV"
        restaurado=1
    fi
    if [[ -f "$SUDOERS_PREV" ]]; then
        install -o root -g root -m 0440 "$SUDOERS_PREV" "$SUDOERS_INSTALADO"
        echo "duna-deploy-buzon: restored $SUDOERS_INSTALADO from $SUDOERS_PREV"
        restaurado=1
    fi
    if [[ "$restaurado" -eq 0 ]]; then
        echo "duna-deploy-buzon: refusing: no previous copy found to roll back to" >&2
        exit 1
    fi
}

dispatch() {
    local subcommand="$1" dry_run="$2" reexec="$3"
    case "$subcommand" in
        status) cmd_status "$dry_run" ;;
        deploy) cmd_deploy "$dry_run" "$reexec" ;;
        entrar) cmd_entrar ;;
        rollback-script) cmd_rollback_script ;;
        carpetas) cmd_carpetas "$CARPETA_ID" ;;
        fijar-carpetas) cmd_fijar_carpetas "$FIJAR_ID" "$FIJAR_TODAS" "${FIJAR_CARPETAS[@]+"${FIJAR_CARPETAS[@]}"}" ;;
        registros) cmd_registros "$REGISTROS_UNIDAD" "$REGISTROS_N" ;;
        rebobinar-cursor) cmd_rebobinar_cursor "$REBOBINAR_ID" "$REBOBINAR_FECHA" "$REBOBINAR_APLICAR" ;;
        reglas-ver) cmd_reglas_ver "$REGLAS_VER_ID" ;;
        reglas) cmd_reglas "$REGLAS_ID" "$REGLAS_APLICAR" ;;
        env-tiene) cmd_env_tiene "$ENV_TIENE_CLAVE" ;;
        env-set) cmd_env_set "$ENV_SET_CLAVE" "$ENV_SET_VALOR" "$ENV_SET_APLICAR" ;;
        alertas) cmd_alertas ;;
    esac
}

__main() {
    parse_args "$@"
    require_root
    dispatch "$SUBCOMMAND" "$DRY_RUN" "$REEXEC"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    __main "$@"
fi
